# Скопируй в .env (НЕ коммить!)
# После любого изменения .env — перезапуск с очисткой: npm run start:lan

# ВАЖНО: в Expo в приложение попадают ТОЛЬКО переменные с префиксом EXPO_PUBLIC_

# claude | grok | openai
EXPO_PUBLIC_AI_PROVIDER=claude

# === Вариант А (рекомендуется): Supabase Edge Function analyze-food ===
# Ключ Claude НЕ нужен в приложении — только в секретах Edge Function (см. supabase/README.md)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Модель (используется Edge Function через секрет CLAUDE_MODEL на сервере)
# EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-6

# === Legacy: Express-прокси (server/) — если без Supabase ===
# EXPO_PUBLIC_AI_PROXY_URL=http://192.168.1.41:8787
# EXPO_PUBLIC_AI_PROXY_TOKEN=

# === Другие провайдеры (опционально) ===
# EXPO_PUBLIC_XAI_API_KEY=xai-...
# EXPO_PUBLIC_GROK_MODEL=grok-2-vision-1212
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# НЕ добавляй EXPO_PUBLIC_CLAUDE_API_KEY в продакшен-клиент!
