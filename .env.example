# Скопируй в .env (НЕ коммить!)
# После любого изменения .env — перезапуск с очисткой: npm run start:clear
# Диагностика: npm run doctor

# ВАЖНО: в Expo в приложение попадают ТОЛЬКО переменные с префиксом EXPO_PUBLIC_

# claude | grok | openai
EXPO_PUBLIC_AI_PROVIDER=claude

# ─── Путь A (рекомендуется): Supabase Auth + Edge Function analyze-food ───
# Ключ Claude НЕ нужен в приложении — только в секретах Edge Function
# (см. supabase/README.md). Дневник и подписка синхронизируются в облако.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Путь B (локальная разработка без Edge Function): Express-прокси ───
# Если задан вместе с Supabase — Claude сначала идёт в Edge Function,
# а при ошибке (функция не задеплоена) падает на этот proxy.
# Для телефона указывай LAN IP компьютера, НЕ localhost.
# EXPO_PUBLIC_AI_PROXY_URL=http://192.168.1.41:8787
# EXPO_PUBLIC_AI_PROXY_TOKEN=

# Модель (клиентский fallback / proxy). На сервере задай секрет CLAUDE_MODEL.
# EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-6

# ─── Другие провайдеры (опционально) ───
# EXPO_PUBLIC_XAI_API_KEY=xai-...
# EXPO_PUBLIC_GROK_MODEL=grok-2-vision-1212
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# НЕ добавляй EXPO_PUBLIC_CLAUDE_API_KEY в продакшен-клиент!
